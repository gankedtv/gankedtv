{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Maintenance": {
    "Enabled": true,
    "SweepInterval": "00:15:00",
    "ClipStaleThreshold": "01:00:00",
    "RefreshTokenRetention": "30.00:00:00",
    "ClipBatchSize": 1000
  },
  "MediaJobs": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "LeaseDuration": "00:05:00",
    "MaxAttempts": 3,
    "ProcessTimeout": "00:02:00",
    "ThumbnailFrameOffset": "00:00:01",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  }
}
