# Dedicated GPU encoder image: gankedtv-server (the same API/worker binary) + an NVENC-capable
# ffmpeg, for the box that runs the compress + JIT (+ thumbnail) media workers on its GPU. The base
# gankedtv-server image ships Debian's SOFTWARE ffmpeg, so av1_nvenc / h264_nvenc would fail at
# encode time; this layer drops in a static NVENC build and points FFMPEG_PATH / FFPROBE_PATH at it.
# NVENC needs the host's NVIDIA driver libs at runtime, provided by GPU passthrough (TrueNAS Scale
# apps wire this out of the box). Nothing in the image is GPU-specific until those libs are present,
# so the build itself needs no GPU. It's the same binary as gankedtv-server — runtime env
# (MEDIA_*_WORKER_ENABLED, MEDIA_VIDEO_ENCODER=av1_nvenc, …) is what makes it the encoder; see
# DEPLOYMENT.md.

ARG BASE_IMAGE=ghcr.io/gankedtv/gankedtv-server:latest
FROM ${BASE_IMAGE}

# Static, self-contained GPL build with NVENC/NVDEC + libsvtav1 + libx264. The NVENC driver floor
# is set by the nv-codec-headers version the build was COMPILED against, NOT by the FFmpeg version
# — so the encoder is pinned by *build*, not FFmpeg release number. BtbN's floating `master` tracks
# the newest nv-codec-headers (NVENC API 13.1 → needs NVIDIA driver ≥610), so av1_nvenc fails to
# open on an older driver and hard-fails every clip. jellyfin-ffmpeg is built for exactly this
# constraint: its documented NVIDIA floor is driver ≥520.56.06, so av1_nvenc opens on the older
# drivers shipped by appliances like TrueNAS Scale while still doing hardware AV1 on Ada+ GPUs.
# Pinned to a specific version for reproducibility; override with --build-arg FFMPEG_URL=... (any
# build works — but verify av1_nvenc actually opens on the host driver first).
ARG FFMPEG_URL=https://repo.jellyfin.org/releases/ffmpeg/7.1.4-3/jellyfin-ffmpeg_7.1.4-3_portable_linux64-gpl.tar.xz

USER root
# Extraction is layout-agnostic: BtbN nests binaries under <root>/bin/, jellyfin's portable tarball
# lays them out differently, so locate ffmpeg/ffprobe with `find` and symlink to a stable path
# rather than hardcoding either layout. Portable binaries resolve their bundled libs via an $ORIGIN
# rpath, so a symlink (not a copy) keeps them next to their lib/ dir.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl xz-utils ca-certificates \
    && mkdir -p /opt/ffmpeg \
    && curl -fsSL "$FFMPEG_URL" -o /tmp/ffmpeg.tar.xz \
    && tar -xJf /tmp/ffmpeg.tar.xz -C /opt/ffmpeg \
    && rm /tmp/ffmpeg.tar.xz \
    && ln -sf "$(find /opt/ffmpeg -type f -name ffmpeg | head -n1)" /usr/local/bin/ffmpeg \
    && ln -sf "$(find /opt/ffmpeg -type f -name ffprobe | head -n1)" /usr/local/bin/ffprobe \
    && apt-get purge -y xz-utils \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    # Fail the build if the AV1 NVENC encoder isn't compiled in — this only lists encoders (no GPU
    # needed at build time) and also proves the portable binary loads its bundled libs.
    && ffmpeg -hide_banner -encoders | grep -q av1_nvenc

# Override the bundled software ffmpeg/ffprobe (MediaJobOptions reads these).
ENV FFMPEG_PATH=/usr/local/bin/ffmpeg \
    FFPROBE_PATH=/usr/local/bin/ffprobe

USER gankedtv
