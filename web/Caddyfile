# Internal static server for the production web image. No TLS and no hostname on purpose — TLS is
# terminated by the upstream reverse proxy (nginx proxy manager, Traefik, …) which forwards to this
# container's :80. try_files routes unknown paths to index.html so Vue Router deep links resolve
# (SPA fallback).
:80 {
	root * /srv
	encode gzip zstd
	try_files {path} /index.html
	file_server

	# Hashed asset filenames are content-addressed, so cache them forever; the HTML shell must
	# revalidate every load so a new deploy is picked up without a hard refresh.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
