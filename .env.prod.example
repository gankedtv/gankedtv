# Production env for docker-compose.prod.yml (generic single-host deploy).
#   cp .env.prod.example .env   # then fill in, next to docker-compose.prod.yml
# NEVER commit the filled copy. Per-variable prose lives in .env.example + DEPLOYMENT.md; this file
# only carries the prod-shaped values the compose stack reads. Alternatively, leave the secrets here
# blank and supply them from Vaultwarden (set VAULTWARDEN_API_URL/KEY) — see DEPLOYMENT.md.

# Pin all images to a commit SHA (reproducible) or leave at latest (auto-updaters track :latest).
IMAGE_TAG=latest

# ── Postgres (compose-internal; the api/bot connection strings are derived from these) ──
POSTGRES_DB=gankedtv
POSTGRES_USER=gankedtv
POSTGRES_PASSWORD=                       # REQUIRED. Keep it connection-string/URL-safe (no ';' '@' '/').

# ── Object storage (AIStor — MinIO's maintained successor) ──
# These doubly serve as the object store's root credentials AND the api's S3 creds. NOT 'minioadmin'
# (rejected in Production); the secret must be >= 8 chars.
S3_ACCESS_KEY=                           # REQUIRED
S3_SECRET_KEY=                           # REQUIRED
# Browser-facing base URL your reverse proxy maps to the store's :9000 (public media/cover/avatar URLs).
S3_PUBLIC_URL=https://cdn.example.com    # REQUIRED
# Internal api -> store address. Default (compose service) is fine for single-host; point this at a
# remote store (e.g. http://10.0.0.x:9000) to split storage onto another box.
# S3_ENDPOINT=http://minio:9000
# AIStor free-tier license (single-node). Download a free key from https://min.io/download and save
# the token to this file — it's mounted into the container (the only container-supported way; without
# it AIStor blocks all S3 ops). Path is relative to the compose file. Keep it OUT of git (secrets/).
MINIO_LICENSE_FILE=./secrets/minio.license

# ── Web app (runtime config; injected into config.js at container start, not baked) ──
# These are ALL public — they ship to every browser — and the web bundle has no vault client, so
# they MUST live here (NOT in Vaultwarden), unlike the API/bot secrets below.
# Browser-facing API URL (through your reverse proxy). REQUIRED for the web app to reach the API.
VITE_API_BASE_URL=https://api.example.com
VITE_USE_SECURE_COOKIES=true             # HttpOnly-cookie refresh tokens; MUST match AUTH_REFRESH_COOKIE_ENABLED below
VITE_GA_MEASUREMENT_ID=                  # GA4 id (empty = analytics off)
VITE_SENTRY_DSN=                         # web GlitchTip DSN (empty = off) — host-supplied, not vaulted
VITE_SENTRY_ENVIRONMENT=Production
VITE_SENTRY_RELEASE=                     # release/tag for Sentry (empty = package version)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.01
# Where the web container's Caddy proxies link-preview traffic (crawler hits on /c/* and /clip/*,
# plus /oembed and the share-media paths). Default reaches the compose-internal api service; set to
# the public API URL (e.g. https://api.example.com) on a split deployment where it doesn't.
SHARE_PREVIEW_UPSTREAM=api:5000

# ── Auth / CORS (fail-fast required in Production) ──
JWT_SECRET=                              # REQUIRED, >= 32 bytes: openssl rand -hex 32
JWT_ISSUER=gankedtv
JWT_AUDIENCE=gankedtv-web
OAUTH_STATE_SECRET=                      # >= 32 bytes once any OAuth provider is configured
WEB_ORIGIN=https://example.com           # REQUIRED, public origin of the web app
CORS_ORIGINS=https://example.com         # REQUIRED, comma-separated (WEB_ORIGIN is always allowed)
# Server half of the HttpOnly-cookie refresh flow. Keep in sync with VITE_USE_SECURE_COOKIES
# above: both true (cookie mode) or both false (localStorage mode); a mismatch breaks login.
AUTH_REFRESH_COOKIE_ENABLED=true
# Comma-separated emails promoted to admin at API boot (user must register/login once first).
# Promote-only — see DEPLOYMENT.md "Admin bootstrap". May also live in the optional Vaultwarden manifest.
ADMIN_EMAILS=

# ── Host port mappings (your reverse proxy / firewall fronts these) ──
WEB_HTTP_PORT=8080
API_HTTP_PORT=5000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# The MinIO/AIStor admin console binds to loopback by default (not exposed on the LAN). To publish it
# behind your reverse proxy instead, set MINIO_CONSOLE_BIND to an empty value or a specific interface.
# MINIO_CONSOLE_BIND=

# ── OAuth providers (optional; required pairwise once enabled) ──
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.example.com/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback

# ── IGDB game metadata (optional) ──
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── Error monitoring (optional; one GlitchTip project per app) ──
# *_RELEASE tags are optional — unset, each app falls back to its assembly/package version.
# The API/bot Sentry keys below are in each app's OPTIONAL Vaultwarden manifest: if you run
# Vaultwarden, store them in the "Secrets - PROD" collection (named exactly as here) and leave these
# blank — the app fetches them at boot, best-effort (a missing key never fails boot). A non-empty
# value here wins over the vault. (Web's VITE_SENTRY_* is NOT vaulted — see the web block above.)
SENTRY_DSN=
SENTRY_ENVIRONMENT=Production
DISCORD_SENTRY_DSN=
DISCORD_SENTRY_ENVIRONMENT=Production
DISCORD_SENTRY_RELEASE=

# ── Clip limits (optional) ──
MAX_UPLOAD_SIZE_MB=500
MAX_CLIP_DURATION_SECS=120

# ── Discord bot (only used with `--profile discord`) ──
DISCORD_BOT_TOKEN=
DISCORD_BOT_APP_ID=
DISCORD_POLL_INTERVAL_SECONDS=30
# Defaults: GANKEDTV_API_BASE=http://api:5000, GANKEDTV_PUBLIC_BASE=$WEB_ORIGIN. Override if needed.
# GANKEDTV_PUBLIC_BASE=https://example.com
